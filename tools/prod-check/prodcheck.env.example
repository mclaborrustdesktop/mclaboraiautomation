# Copy this file to prodcheck.env (same folder) and fill it in.
# This file is used ONLY by check_readonly.py. The website does not read it.
# NEVER put a password in this file. If a password is needed you will be asked to type it.

# staging = a restored copy of the database, used for testing.  production = the live database.
ENVIRONMENT=staging

# The SQL Server to check.  Examples:  DEV-PC\SQLEXPRESS      LIVE-HOST\SQLEXPRESS
SERVER=
DATABASE=McLabor

# What that server calls itself (normally the same as SERVER). The check stops if a different server answers.
EXPECT_SERVER_NAME=

# windows = use the Windows account you are signed in with (no password typed)
# sql     = use a dedicated read-only SQL login (fill in USER; password is typed when asked)
AUTH=windows
USER=

# Leave these as they are unless the report tells you to change them.
ENCRYPT=yes
TRUST_SERVER_CERTIFICATE=no
