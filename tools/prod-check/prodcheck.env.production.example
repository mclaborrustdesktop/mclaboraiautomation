# Used ONLY by check_readonly.py through run-prodcheck-production.ps1. The website does not read this file.
# NEVER put a password in this file. Copy to prodcheck.env.production and confirm the two server values.

ENVIRONMENT=production

# The live server as established on 2026-11-23 (docs/production/15-live-database-and-production-connection.md):
# LIVE-HOST at <live-host-ip>, instance SQLEXPRESS, fixed TCP port 1433 (the Browser service does not answer, so the
# port is given explicitly). Connect by NAME, not by address: the server's certificate is issued for the name.
SERVER=LIVE-HOST,1433
DATABASE=McLabor

# The check stops if the server that answers does not call itself exactly this (the instance's own name):
EXPECT_SERVER_NAME=LIVE-HOST\SQLEXPRESS

# The restricted read-only login, created on the live server with proposed-grants-production.sql:
AUTH=sql
USER=mclabor_web_read

DRIVER=ODBC Driver 17 for SQL Server

# Encrypted connection with certificate verification ON. Requires the live server's certificate to be trusted on
# this PC (tools\prod-check\trust-server-certificate.ps1).
ENCRYPT=yes
TRUST_SERVER_CERTIFICATE=no
