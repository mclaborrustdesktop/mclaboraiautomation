# SNAPSHOT PHASE of the production website (docs/production/24): the agent reads the office PC's RESTORED COPY of McLabor
# (data as of 2026-11-13) with the read-only login and sends the 33 approved tables to the PRODUCTION website, until the
# live server can be read. Copy to %LOCALAPPDATA%\MCLabor\production\sync.snapshot.env; run with run-sync.ps1 -EnvFile <it>.
DATA_SOURCE=staging
OFFICE_HOSTS=LIVE-HOST,DEV-PC,<live-host-ip>,<dev-pc-ip>
STAGING_DB_SERVER=DEV-PC\SQLEXPRESS
STAGING_DB_NAME=McLabor
STAGING_DB_EXPECTED_SERVER_NAME=DEV-PC\SQLEXPRESS
STAGING_DB_USER=mclabor_web_read
STAGING_DB_DRIVER=ODBC Driver 17 for SQL Server
STAGING_DB_ENCRYPT=true
STAGING_DB_TRUST_SERVER_CERTIFICATE=false
STAGING_WRITES_ENABLED=false
STAGING_WRITE_APPROVAL=
# The PRODUCTION website and its sync key (sync-production.dpapi, not the staging one). The website's SYNC_EXPECTED_SOURCE
# must be DEV-PC\SQLEXPRESS/McLabor during this phase.
SYNC_API=https://<production-host>
SYNC_SECRETS_FILE=sync-production.dpapi
# The agent's state for the PRODUCTION website lives apart from the staging rehearsals and is KEPT when the source later
# becomes the live server, so that rows changed or removed since the snapshot are updated or deleted on the website.
SYNC_STATE_DIR=%LOCALAPPDATA%\MCLabor\sync\production
CF_ACCESS_CLIENT_ID=
