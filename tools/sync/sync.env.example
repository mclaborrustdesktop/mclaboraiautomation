# Settings of the office synchronization agent (copy to tools\sync\sync.env on the office PC that runs it; never commit).
# The agent READS the office SQL Server with the restricted login and SENDS the approved tables to the cloud website.
# Nothing flows back. Secrets are NOT in this file: the SQL password and the sync key are stored encrypted with
# Windows DPAPI by tools\sync\store-sync-secrets.ps1 for the Windows account that runs the scheduled task.

# Which office database to read: the live one (production) once approved, the restored copy (staging) for rehearsals.
DATA_SOURCE=production
# The office hosts by name and address (the agent refuses them as a mirror target); alternatively backend\office-hosts.txt
OFFICE_HOSTS=LIVE-HOST,<live-host-ip>
PRODUCTION_DB_SERVER=LIVE-HOST\SQLEXPRESS
PRODUCTION_DB_NAME=McLabor
PRODUCTION_DB_EXPECTED_SERVER_NAME=LIVE-HOST\SQLEXPRESS
PRODUCTION_DB_USER=mclabor_web_read
PRODUCTION_DB_ENCRYPT=true
PRODUCTION_DB_TRUST_SERVER_CERTIFICATE=false
# Only until the live server has a certificate the office PC trusts: =true is accepted solely together with the owner's
# written statement below (20+ characters, who approved and when). Encrypted connection, server identity not verified.
# PRODUCTION_DB_TLS_WAIVER=
PRODUCTION_WRITES_ENABLED=false
PRODUCTION_WRITE_APPROVAL=

# Where the cloud website is (its custom domain behind Cloudflare Access) and the Cloudflare service token's id.
SYNC_API=https://app.example.com
CF_ACCESS_CLIENT_ID=<service token client id>.access
# The agent's own files (state of the last run, logs). Default: %LOCALAPPDATA%\MCLabor\sync
# SYNC_STATE_DIR=C:\MCLabor\sync
