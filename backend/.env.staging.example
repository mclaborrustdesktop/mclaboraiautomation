# STAGING = the restored copy of McLabor on DEV-PC (restored 2026-11-13 from LIVE-HOST). NOT the live database.
#
# This file is a prepared example. It does nothing until it is copied to backend\.env, and that must not happen
# before the certificate and the read-only login exist on DEV-PC and check_readonly.py has passed.
# To go back to the demo: rename backend\.env to backend\.env.off and restart the website.

DATA_SOURCE=staging

# Required: a new random value. Create one with:
#   .venv\Scripts\python.exe -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---- the one server STAGING may talk to ------------------------------------------------------
STAGING_DB_SERVER=DEV-PC\SQLEXPRESS
STAGING_DB_NAME=McLabor
# Every connection is refused unless the server calls itself exactly this:
STAGING_DB_EXPECTED_SERVER_NAME=DEV-PC\SQLEXPRESS
STAGING_DB_DRIVER=ODBC Driver 17 for SQL Server

# The restricted read-only login (created with tools\prod-check\proposed-grants.sql, after approval):
STAGING_DB_USER=mclabor_web_read
# Leave empty on DEV-PC: tools\staging\run-in-staging.ps1 supplies the password from the encrypted store.
STAGING_DB_PASSWORD=

# Who may use the website with real data. Initials, OfficeStaffID numbers or e-mail addresses, separated by commas.
# Nobody else gets in, even with a web password. (tools\staging\add-pilot-user.ps1 adds an administrator and sets
# their web password.)
#   WEB_ADMINS - everything, including user management and the system status page
#   WEB_USERS  - look-up only: employees, customers, jobs, weekly tracking, AI search; no changes, no user management
WEB_ADMINS=
WEB_USERS=

# Outside AI service. Leave the key EMPTY with real data: questions are then understood on this PC. If the owner
# approves sending questions to Claude, put the approval reference here as well, or the website refuses to start.
ANTHROPIC_API_KEY=
CLAUDE_REAL_DATA_APPROVAL=

# How people get in. Leave as "login" (web sign-in page). "open" (no sign-in) is refused with real data.
# "gateway" (no sign-in page, company VPN / Zero Trust gateway in front) is prepared but must not be switched on
# before the checklist in docs\access-without-login.md is complete.
ACCESS_MODE=login
# GATEWAY_SECRET=
# GATEWAY_EMAIL_HEADER=X-Auth-Request-Email
# GATEWAY_TRUSTED_PROXIES=127.0.0.1,::1     (the address the gateway forwards from; requests from anywhere else are refused)
# Do NOT use Windows sign-in here: on DEV-PC the Windows account is a SQL Server administrator.
STAGING_DB_TRUSTED_CONNECTION=false

# Must stay as they are; the website refuses to start otherwise:
STAGING_DB_ENCRYPT=true
STAGING_DB_TRUST_SERVER_CERTIFICATE=false

# Reading only. Leave both lines exactly like this:
STAGING_WRITES_ENABLED=false
STAGING_WRITE_APPROVAL=

# Do not put any PRODUCTION_* settings in a staging file. If both are present and name the same server and
# database, the website refuses to start.
