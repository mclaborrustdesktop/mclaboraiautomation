# PRODUCTION = the LIVE McLabor database on LIVE-HOST (<live-host-ip>), as established on 2026-11-23 and to be confirmed
# by the staff-PC check and the owner's statement (docs/production/15-live-database-and-production-connection.md).
#
# This file does nothing until it is copied to backend\.env. Do that only after, in this order:
#   1. tools\prod-check\run-prodcheck-production.ps1 ends with READ-ONLY CONNECTION VERIFIED
#   2. tools\gateway-check.ps1 -EnvFile backend\.env.production reports 0 problems
#   3. the access lists below are filled in (tools\staging\manage-web-access.ps1 -EnvFile backend\.env.production ...)
# To go back to the demo: rename backend\.env to backend\.env.off and restart the website.

DATA_SOURCE=production

# Required: a new random value, different from staging. Create one with:
#   .venv\Scripts\python.exe -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---- the one server PRODUCTION may talk to ---------------------------------------------------
# By name and fixed port (the Browser service on LIVE-HOST does not answer; the certificate is issued for the name).
PRODUCTION_DB_SERVER=LIVE-HOST,1433
PRODUCTION_DB_NAME=McLabor
# Every connection is refused unless the server calls itself exactly this:
PRODUCTION_DB_EXPECTED_SERVER_NAME=LIVE-HOST\SQLEXPRESS
PRODUCTION_DB_DRIVER=ODBC Driver 17 for SQL Server

# The restricted read-only login (proposed-grants-production.sql, run by the administrator on LIVE-HOST):
PRODUCTION_DB_USER=mclabor_web_read
# Leave empty: tools\production\start-production.ps1 supplies the password from the encrypted store.
PRODUCTION_DB_PASSWORD=
PRODUCTION_DB_TRUSTED_CONNECTION=false

# Must stay as they are; the website refuses to start otherwise:
PRODUCTION_DB_ENCRYPT=true
PRODUCTION_DB_TRUST_SERVER_CERTIFICATE=false

# Reading only. Writes need a separate written approval; see docs/production/16-add-edit-plan.md.
PRODUCTION_WRITES_ENABLED=false
PRODUCTION_WRITE_APPROVAL=

# ---- who may use the website ------------------------------------------------------------------
# Initials, OfficeStaffID numbers or e-mail addresses, separated by commas. Nobody else gets in.
WEB_ADMINS=
WEB_USERS=

# ---- how people get in ---------------------------------------------------------------------------
# gateway = no website sign-in page; the company gateway (deploy\gateway) signs people in and names them by e-mail.
# Until the gateway is running use "login" (sign-in page with web passwords set by an administrator).
ACCESS_MODE=login
# GATEWAY_SECRET=              48+ random characters; the same value is configured in the reverse proxy
# GATEWAY_EMAIL_HEADER=X-Auth-Request-Email         (Cloudflare Access: Cf-Access-Authenticated-User-Email)
# GATEWAY_TRUSTED_PROXIES=127.0.0.1,::1             (the reverse proxy runs on this PC)

# ---- outside AI service ------------------------------------------------------------------------
# Leave the key EMPTY: questions are understood on this PC. Only with the owner's written approval reference:
ANTHROPIC_API_KEY=
CLAUDE_REAL_DATA_APPROVAL=

SEED_ON_STARTUP=false
# Do not put any STAGING_* settings in this file.
