# Copy to backend/.env and edit.  backend/.env holds secrets - never commit it or paste it into chat.

# ---- Security (required before real users; production refuses to start without it) --------
# JWT_SECRET=replace-with-a-long-random-string        (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")

# ---- AI search ---------------------------------------------------------------
# Without a key the built-in offline parser is used.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

# ---- Demo data ---------------------------------------------------------------
# DEMO_PASSWORD=mclabor2025

# ---- Web sign-in ---------------------------------------------------------------
# Web passwords are stored here, never in tblOfficeStaff. Give a staff member a web password with:
#     .venv\Scripts\python.exe -m app.webauth set-password INITIALS
# WEB_AUTH_DATABASE_URL=sqlite:///C:/path/to/web_auth.db      (default: backend/web_auth.db - include it in backups)

# ---- PostgreSQL (the cloud database; deploy/railway) --------------------------
# An environment with a *_DATABASE_URL uses PostgreSQL instead of SQL Server (read-write: it is the company's own
# database). Staging holds synthetic data only until a migration is approved. DB_SHAPE=production means the tables have
# the McLabor structure (built by app.pgschema); demo = the demo's convenience columns (create_all).
# STAGING_DATABASE_URL=postgresql+psycopg://user:pw@host:5432/mclabor_staging?sslmode=require
# PRODUCTION_DATABASE_URL=
# DB_SHAPE=production
# Local development on PostgreSQL in the demo environment (python -m app.pgschema / python -m app.synthdb build the tables):
# DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/mclabor_dev

# ---- Production SQL Server (McLabor) - OFF and READ-ONLY by default ----------
# Leave these commented out until tools\prod-check\check_readonly.py reports
# "READ-ONLY CONNECTION VERIFIED" with a restricted login and a verified certificate.
# DATA_SOURCE=production
# PRODUCTION_DB_SERVER=DEV-PC\SQLEXPRESS
# PRODUCTION_DB_NAME=McLabor
# PRODUCTION_DB_DRIVER=ODBC Driver 17 for SQL Server
# Sign-in to SQL Server - choose one:
#   a) Windows account that runs the web app (must be the restricted account from proposed-grants.sql):
# PRODUCTION_DB_TRUSTED_CONNECTION=true
#   b) dedicated read-only SQL login:
# PRODUCTION_DB_USER=mclabor_web_read
# PRODUCTION_DB_PASSWORD=                        (type it here, on the server only)
# Encryption and certificate verification must stay on; the app refuses to start otherwise:
# PRODUCTION_DB_ENCRYPT=true
# PRODUCTION_DB_TRUST_SERVER_CERTIFICATE=false

# In production the app never requests: tblEmployee.EmDOB / USCitizen / I9Complete, tblOfficeStaff.OfficeStaffPassword.

# The office SQL Server hosts (names and addresses), so the guards can refuse them as PostgreSQL / synthetic / mirror
# targets. Not in the code or in this template: set OFFICE_HOSTS here, or list them one per line in backend/office-hosts.txt.
# OFFICE_HOSTS=live-host,copy-host,<live-host-ip>,<copy-host-ip>

# Writes stay blocked unless BOTH are set (and even then schema changes are never sent):
# PRODUCTION_WRITES_ENABLED=false
# PRODUCTION_WRITE_APPROVAL=                     (change ticket / sign-off reference)
