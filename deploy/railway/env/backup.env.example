# Railway service "backup" (root directory: deploy/railway/backup; cron 07:00 UTC daily from its railway.json).
DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
ADMIN_DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
BACKUP_PREFIX=${{RAILWAY_ENVIRONMENT_NAME}}
# S3-compatible object storage OUTSIDE Railway (Cloudflare R2: 10 GB free; or AWS S3 / Backblaze B2)
S3_BUCKET=mclabor-backups
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=<sealed>
AWS_SECRET_ACCESS_KEY=<sealed>
# long random passphrase, SEALED here and kept in the password safe: without it no backup can be restored
BACKUP_PASSPHRASE=<sealed>
KEEP_DAYS=35
