# Railway service "backend", environment "staging" - variables (Railway > service > Variables). Synthetic data only.
# Values in ${{ }} are Railway references, resolved by Railway; nothing secret is written here.

DATA_SOURCE=staging
# the Postgres service's PRIVATE URL (no public port is ever opened on the database)
STAGING_DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
# the website's own store (sign-in, access roles, change log) lives in the same database
WEB_AUTH_DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
DB_SHAPE=production
WEB_WORKERS=2
# search-only mirror of the office system, fed by the office agent (tools/sync): no Add/Edit/Delete for anyone
SITE_MODE=search-only
# the agent's key: python -c "import secrets;print(secrets.token_urlsafe(48))" - sealed here, stored with DPAPI on the office PC
SYNC_API_KEY=<sealed>
SYNC_STALE_HOURS=14
SYNC_SOURCE_LABEL=the office McLabor system
# the only source this website accepts runs from (as the agent announces it); anything else is refused with HTTP 409
SYNC_EXPECTED_SOURCE=sqlite (given)

# sign-in: Cloudflare Access in front of the custom domain; the token it signs is the proof (no website login screen)
# ACCESS_MODE=gateway   (alternative: Cloudflare Access alone decides who you are; the chosen mode is the passcode block below)
GATEWAY_PLATFORM=cloudflare-access
GATEWAY_TRUSTED_PROXIES=any
CLOUDFLARE_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=<the Access application's AUD tag>
# bootstrap administrators (initials or e-mail of the SYNTHETIC staff in staging); everyone else is granted on the Users page
WEB_ADMINS=ARI
WEB_USERS=
# One-time, sealed: the first administrator (ARI) signs in with it once, is made to choose a real password, then delete
# this variable. Only while ARI has no web password yet; never for anyone else. 16+ characters, generated.
WEB_BOOTSTRAP_PASSWORD=<sealed>
ACCESS_SEAT_LIMIT=20
ACCESS_SEAT_WARN=16
ACCESS_OTHER_SEATS=8

# sealed in Railway (Variables > Add > Seal): python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<sealed>
# no outside AI service with real data without the owner's written approval (CLAUDE_REAL_DATA_APPROVAL)
ANTHROPIC_API_KEY=

LOG_FORMAT=json
ACCESS_LOG=true
LOG_LEVEL=INFO
CORS_ORIGINS=https://staging.<domain>

# Password-only entrance (docs/cloud/18-password-only-access.md). ACCESS_MODE=passcode replaces the user-name sign-in.
# SITE_PASSWORD_HASH comes from `python -m app.webauth site-password` (hidden prompt; never the password itself). Seal it.
# Production refuses the labels initial/staging/test/demo: generate a new secret for production and label it.
ACCESS_MODE=passcode
SITE_PASSWORD_HASH=<sealed: pbkdf2$...>
SITE_PASSWORD_LABEL=initial
SITE_DEFAULT_USER=ARI
SITE_SESSION_MINUTES=480
# Approved devices behind the password (docs/cloud/18 section 2): OFF by the owner's decision of 2026-11-27 (password only).
# Switching it on needs the three WebAuthn settings below and re-enrols every device; leave false for the plain entrance.
SITE_DEVICE_APPROVAL=false
WEBAUTHN_RP_ID=<the website's host name, e.g. search.example.com>
WEBAUTHN_ORIGIN=https://<that host>
SITE_DEVICE_LIMIT=40
# one-time, sealed: approves the first device as SITE_DEFAULT_USER while no approved device exists; delete afterwards
SITE_DEVICE_BOOTSTRAP_CODE=<sealed>
