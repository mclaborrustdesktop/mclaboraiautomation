# Railway service "backend", environment "staging" - variables (Railway > service > Variables). Synthetic data only.
# Values in ${{ }} are Railway references, resolved by Railway; nothing secret is written here.

DATA_SOURCE=staging
# the Postgres service's PRIVATE URL (no public port is ever opened on the database)
STAGING_DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
# the website's own store (sign-in, access roles, change log) lives in the same database
WEB_AUTH_DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
DB_SHAPE=production
WEB_WORKERS=2
# search-only mirror of the office system, fed by the office agent (tools/sync): no Add/Edit/Delete for anyone
SITE_MODE=search-only
# the agent's key: python -c "import secrets;print(secrets.token_urlsafe(48))" - sealed here, stored with DPAPI on the office PC
SYNC_API_KEY=<sealed>
SYNC_STALE_HOURS=14
SYNC_SOURCE_LABEL=the office McLabor system

# sign-in: Cloudflare Access in front of the custom domain; the token it signs is the proof (no website login screen)
ACCESS_MODE=gateway
GATEWAY_PLATFORM=cloudflare-access
GATEWAY_TRUSTED_PROXIES=any
CLOUDFLARE_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=<the Access application's AUD tag>
# bootstrap administrators (initials or e-mail of the SYNTHETIC staff in staging); everyone else is granted on the Users page
WEB_ADMINS=ARI
WEB_USERS=
ACCESS_SEAT_LIMIT=20
ACCESS_SEAT_WARN=16
ACCESS_OTHER_SEATS=8

# sealed in Railway (Variables > Add > Seal): python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<sealed>
# no outside AI service with real data without the owner's written approval (CLAUDE_REAL_DATA_APPROVAL)
ANTHROPIC_API_KEY=

LOG_FORMAT=json
ACCESS_LOG=true
LOG_LEVEL=INFO
CORS_ORIGINS=https://staging.<domain>
