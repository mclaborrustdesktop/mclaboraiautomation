# Railway service "frontend" (root directory: frontend). The same in staging and production, with its own values.

# empty = the browser calls /api on the website's own address; the Next.js server forwards it over the private network
NEXT_PUBLIC_API_URL=
# where the API lives on the private network: <backend service name>.railway.internal and the backend's PORT
BACKEND_INTERNAL_URL=http://backend.railway.internal:8000
PORT=3000
HOSTNAME=::
