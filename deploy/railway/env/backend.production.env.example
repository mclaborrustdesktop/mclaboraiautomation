# Railway service "backend", environment "production". Used only after the owner approves the migration of the
# McLabor data from SQL Server (docs/cloud/12-railway-plan.md, section 7). Until then production does not exist.

DATA_SOURCE=production
PRODUCTION_DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
WEB_AUTH_DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
DB_SHAPE=production
WEB_WORKERS=2
SITE_MODE=search-only
SYNC_API_KEY=<sealed, different from staging>
SYNC_STALE_HOURS=14
SYNC_SOURCE_LABEL=the office McLabor system

ACCESS_MODE=gateway
GATEWAY_PLATFORM=cloudflare-access
GATEWAY_TRUSTED_PROXIES=any
CLOUDFLARE_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=<the production Access application's AUD tag - a different application from staging>
# two real administrators by e-mail (as in tblOfficeStaff.OfficeStaffEmail); the rest are granted on the Users page
WEB_ADMINS=<admin1@company>,<admin2@company>
WEB_USERS=
ACCESS_SEAT_LIMIT=20
ACCESS_SEAT_WARN=16
ACCESS_OTHER_SEATS=8

JWT_SECRET=<sealed, different from staging>
ANTHROPIC_API_KEY=
CLAUDE_REAL_DATA_APPROVAL=

LOG_FORMAT=json
ACCESS_LOG=true
LOG_LEVEL=INFO
CORS_ORIGINS=https://app.<domain>
