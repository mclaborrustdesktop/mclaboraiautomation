# Backend settings for PRODUCTION on the VM. Installed by deploy-app.ps1 as C:\mclabor\production\backend.env (never
# overwritten on an update). No secret in this file: jwt_secret and production_db_password are files in
# C:\mclabor\production\secrets (MCLABOR_SECRETS_DIR), readable by the service account only.
DATA_SOURCE=production

# SQL Server 2019 Express on this VM, by the VM's own name (the certificate is issued for it)
PRODUCTION_DB_SERVER=<VM-NAME>\SQLEXPRESS
PRODUCTION_DB_NAME=McLabor
PRODUCTION_DB_EXPECTED_SERVER_NAME=<VM-NAME>\SQLEXPRESS
PRODUCTION_DB_DRIVER=ODBC Driver 18 for SQL Server
PRODUCTION_DB_USER=mclabor_web_read
PRODUCTION_DB_TRUSTED_CONNECTION=false
PRODUCTION_DB_ENCRYPT=true
PRODUCTION_DB_TRUST_SERVER_CERTIFICATE=false
PRODUCTION_WRITES_ENABLED=false
PRODUCTION_WRITE_APPROVAL=

# Sign-in: Cloudflare Access in front of the tunnel; the backend verifies the token Cloudflare attaches.
ACCESS_MODE=gateway
GATEWAY_PLATFORM=cloudflare-access
GATEWAY_TRUSTED_PROXIES=127.0.0.1,::1
CLOUDFLARE_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=<AUD tag of the production Access application>

# Bootstrap administrators only (two or three people who can never be locked out; initials or the e-mail they sign in with).
# Everyone else is granted "admin" or "user" by an administrator on the Users page (or `python -m app.webauth access-set`),
# stored in the website's own sign-in file, effective at once, no restart. Company maximum: 20 website users.
WEB_ADMINS=
WEB_USERS=
# The website refuses the 21st authorized user and warns from the 16th. The sign-in service (Cloudflare Zero Trust) is
# free up to 50 users counting website users AND the WARP users of the Access/QuickBooks PCs (ACCESS_OTHER_SEATS).
ACCESS_SEAT_LIMIT=20
ACCESS_SEAT_WARN=16
ACCESS_SERVICE_LIMIT=50
ACCESS_OTHER_SEATS=8

# No outside AI service unless approved in writing
ANTHROPIC_API_KEY=
CLAUDE_REAL_DATA_APPROVAL=

LOG_FORMAT=json
ACCESS_LOG=true
SEED_ON_STARTUP=false
WEB_AUTH_DATABASE_URL=sqlite:///C:/mclabor/production/data/web_auth_production.db
SCHEMA_CSV_DIR=C:\mclabor\production\app\docs\schema
