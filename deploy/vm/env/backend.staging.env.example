# Backend settings for STAGING on the VM (synthetic database first; the restored copy only after its own approval).
# Installed by deploy-app.ps1 as C:\mclabor\staging\backend.env. Secrets: C:\mclabor\staging\secrets.
DATA_SOURCE=staging

STAGING_DB_SERVER=<VM-NAME>\SQLEXPRESS
STAGING_DB_NAME=McLaborStaging
STAGING_DB_EXPECTED_SERVER_NAME=<VM-NAME>\SQLEXPRESS
STAGING_DB_DRIVER=ODBC Driver 18 for SQL Server
STAGING_DB_USER=mclabor_web_read
STAGING_DB_TRUSTED_CONNECTION=false
STAGING_DB_ENCRYPT=true
STAGING_DB_TRUST_SERVER_CERTIFICATE=false
STAGING_WRITES_ENABLED=false
STAGING_WRITE_APPROVAL=

ACCESS_MODE=gateway
GATEWAY_PLATFORM=cloudflare-access
GATEWAY_TRUSTED_PROXIES=127.0.0.1,::1
CLOUDFLARE_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=<AUD tag of the STAGING Access application - different from production>

WEB_ADMINS=
WEB_USERS=
ACCESS_SEAT_LIMIT=20
ACCESS_SEAT_WARN=16
ACCESS_SERVICE_LIMIT=50
ACCESS_OTHER_SEATS=8

ANTHROPIC_API_KEY=
CLAUDE_REAL_DATA_APPROVAL=

LOG_FORMAT=json
ACCESS_LOG=true
SEED_ON_STARTUP=false
WEB_AUTH_DATABASE_URL=sqlite:///C:/mclabor/staging/data/web_auth_staging.db
SCHEMA_CSV_DIR=C:\mclabor\staging\app\docs\schema
