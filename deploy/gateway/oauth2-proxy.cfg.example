# TEMPLATE - not in use. oauth2-proxy signing office staff in with their Microsoft 365 account before Caddy
# forwards anything to the MC Labor website. Google Workspace works the same way with provider = "google".
# Secrets go in environment variables (OAUTH2_PROXY_CLIENT_SECRET, OAUTH2_PROXY_COOKIE_SECRET), never in this file.

http_address = "127.0.0.1:4180"
reverse_proxy = true                       # Caddy sits in front; trust its X-Forwarded-* headers
upstreams = [ "static://202" ]             # used only as an auth check by Caddy's forward_auth

provider = "entra-id"                      # Microsoft 365 / Entra ID ("google" for Google Workspace)
oidc_issuer_url = "https://login.microsoftonline.com/<TENANT-ID>/v2.0"
client_id = "<APPLICATION-CLIENT-ID>"
# client_secret: OAUTH2_PROXY_CLIENT_SECRET in the environment

email_domains = [ "mclabor.com" ]          # only company accounts; the website then checks WEB_ADMINS / WEB_USERS
# Two-step verification is enforced in Entra ID / Google for these accounts, not here.

cookie_secure = true
cookie_samesite = "lax"
cookie_expire = "8h"                       # a working day; sign in again next morning
cookie_refresh = "1h"
# cookie_secret: OAUTH2_PROXY_COOKIE_SECRET in the environment (32 random bytes, base64)

set_xauthrequest = true                    # answer with X-Auth-Request-Email for Caddy's copy_headers
pass_access_token = false                  # the website never sees the Microsoft/Google token
skip_provider_button = true
redirect_url = "https://mclabor.internal.example/oauth2/callback"
