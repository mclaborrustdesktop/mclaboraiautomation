# Compose-level settings (copy to deploy/cloud/.env.cloud). No secrets here: secrets are files in deploy/cloud/secrets/.
SITE_NAME=mclabor.example.com                      # the site's public name; Caddy obtains its HTTPS certificate for it
ACME_EMAIL=it@example.com                          # certificate-expiry notices
COMPANY_EMAIL_DOMAIN=mclabor.com                   # only accounts in this domain may sign in
OAUTH2_CLIENT_ID=<app registration client id>
OAUTH2_ISSUER_URL=https://login.microsoftonline.com/<TENANT-ID>/v2.0   # Google: https://accounts.google.com
# Addresses the backend accepts gateway headers from: the proxy container's network (Compose default range).
PROXY_ADDRESSES=172.16.0.0/12
