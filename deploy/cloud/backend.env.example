# Backend settings for the container deployment (copy to deploy/cloud/backend.env). NO secrets in this file:
# jwt_secret, gateway_secret and the database password are files in deploy/cloud/secrets/ (Docker secrets, read
# through MCLABOR_SECRETS_DIR=/run/secrets). Same rules as on a PC: one environment per file, read-only, access lists.

DATA_SOURCE=production                              # or staging for the rehearsal copy in the cloud

# The cloud database, by its full name and port. Encrypted with certificate verification (Azure's certificates are
# issued by a public authority, so nothing has to be trusted by hand).
PRODUCTION_DB_SERVER=<sql-vm-name>.<region>.cloudapp.azure.com,1433
#   Azure SQL Database would be:  <server>.database.windows.net,1433   (see docs/cloud/01 for the identity-check difference)
PRODUCTION_DB_NAME=McLabor
PRODUCTION_DB_EXPECTED_SERVER_NAME=<what the cloud server calls itself - confirm with check_readonly.py>
PRODUCTION_DB_USER=mclabor_web_read
PRODUCTION_DB_ENCRYPT=true
PRODUCTION_DB_TRUST_SERVER_CERTIFICATE=false
PRODUCTION_WRITES_ENABLED=false
PRODUCTION_WRITE_APPROVAL=
DB_CONNECT_TIMEOUT=15
DB_CONNECT_RETRIES=3

# How people get in: the proxy container signs them in (no website login screen) and names them by e-mail.
ACCESS_MODE=gateway
GATEWAY_PLATFORM=proxy
GATEWAY_EMAIL_HEADER=X-Auth-Request-Email
# GATEWAY_TRUSTED_PROXIES is set by docker-compose.yml (PROXY_ADDRESSES)

# Who may use the website
WEB_ADMINS=
WEB_USERS=

# No outside AI service unless approved in writing
ANTHROPIC_API_KEY=
CLAUDE_REAL_DATA_APPROVAL=

LOG_FORMAT=json
ACCESS_LOG=true
SEED_ON_STARTUP=false
